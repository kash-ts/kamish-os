[Unit]
Description=Kamish OS Web Panel Backend
After=network.target kamish-core.service
Requires=kamish-core.service

[Service]
Type=simple
User=kamish
Group=kamish

WorkingDirectory=/opt/kamish
ExecStart=/opt/kamish/bin/kamish-web

Restart=always
RestartSec=5s
TimeoutStopSec=10s

# Environment configuration
EnvironmentFile=-/etc/kamish/kamish-web.env
Environment="RUST_LOG=info"
Environment="HOST=0.0.0.0"
Environment="PORT=8080"
Environment="WEB_DATABASE_URL=sqlite:///var/lib/kamish/web.db"
Environment="KAMISH_IPC_SOCKET=/run/kamish/core.sock"
Environment="STATIC_DIR=/opt/kamish/frontend"

# System and resource hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# Writable state directories
ReadWritePaths=/var/lib/kamish /var/log/kamish /tmp /run/kamish

# Capabilities required for binding HTTP port 80/8080
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Memory and CPU limits
MemoryHigh=128M
MemoryMax=192M
CPUQuota=40%

[Install]
WantedBy=multi-user.target
