[Unit]
Description=KAMISH OS Persistent Data Mounts and Directories Initialization
DefaultDependencies=no
After=local-fs.target data.mount
Wants=data.mount
Before=sysinit.target kamish.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c '\
    mkdir -p /data/kamish /data/log/kamish /data/network /data/ssh /data/vpn /data/audio; \
    chown -R kamish:kamish /data/kamish /data/log/kamish 2>/dev/null || true; \
    mkdir -p /var/lib/kamish /var/log/kamish; \
    mountpoint -q /var/lib/kamish || mount --bind /data/kamish /var/lib/kamish 2>/dev/null || true; \
    mountpoint -q /var/log/kamish || mount --bind /data/log/kamish /var/log/kamish 2>/dev/null || true'
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
