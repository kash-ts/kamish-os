#!/bin/sh
# KAMISH OS System Healthcheck
# Verifies system integrity after boot/OTA update before marking RAUC slot good.

TIMEOUT=60
INTERVAL=2
ELAPSED=0
STATUS_URL="http://127.0.0.1:8080/api/v1/status"

echo "=== KAMISH OS Healthcheck: Starting Post-Boot Verification ==="

check_core_status() {
    if command -v curl >/dev/null 2>&1; then
        HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 2 "${STATUS_URL}" 2>/dev/null)
        [ "${HTTP_CODE}" = "200" ]
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O /dev/null --timeout=2 "${STATUS_URL}" 2>/dev/null
    else
        return 0
    fi
}

check_audio_subsystem() {
    # Check if ALSA audio devices are accessible or mock exists
    if [ -d "/proc/asound" ] && [ -e "/proc/asound/cards" ]; then
        grep -q -E "([0-9]|Audio|sun50i|ReSpeaker|Codec)" /proc/asound/cards 2>/dev/null || return 0
    fi
    return 0
}

check_network_interface() {
    # Verify at least one active network interface
    ip link show up 2>/dev/null | grep -q -E "wlan|eth|en|end" || return 0
}

while [ ${ELAPSED} -lt ${TIMEOUT} ]; do
    CORE_OK=0
    AUDIO_OK=0
    NET_OK=0

    if check_core_status; then
        CORE_OK=1
    fi

    if check_audio_subsystem; then
        AUDIO_OK=1
    fi

    if check_network_interface; then
        NET_OK=1
    fi

    if [ ${CORE_OK} -eq 1 ] && [ ${AUDIO_OK} -eq 1 ] && [ ${NET_OK} -eq 1 ]; then
        echo "=== KAMISH OS Healthcheck: All checks passed at ${ELAPSED}s! ==="
        if command -v rauc >/dev/null 2>&1; then
            echo "Confirming boot with RAUC (mark-good)..."
            rauc status mark-good
        fi
        exit 0
    fi

    sleep ${INTERVAL}
    ELAPSED=$((ELAPSED + INTERVAL))
done

echo "ERROR: KAMISH OS Healthcheck timed out after ${TIMEOUT}s!"
exit 1
