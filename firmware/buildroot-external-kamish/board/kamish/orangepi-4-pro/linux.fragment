# Allwinner A733 (sun60iw2) BSP Platform & Drivers for Orange Pi 4 Pro
# Verified against live Orange Pi 1.1.0 (6.6.98-sun60iw2) kernel config
CONFIG_AW_BSP=y
CONFIG_AW_KERNEL_ORIGIN=y
CONFIG_ARCH_SUN60I=y
CONFIG_ARCH_SUN60IW2=y
CONFIG_ARCH_SUN60IW2P1=y
CONFIG_AW_IC_BOARD=y
CONFIG_AW_SOC_NAME="A733"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MODULES=y

# Core SoC infrastructure (CCU, Pinctrl, Power Domains, NMI/Wakeupgen/SID/SMC/DMA/IOMMU/TWI/RTC/Thermal)
CONFIG_AW_CCU=y
CONFIG_AW_STANDARD_CCU=y
CONFIG_AW_DDR_CCU=y
CONFIG_AW_SUN60IW2_CCU=y
CONFIG_AW_SUN60IW2_R_CCU=y
CONFIG_AW_RTC_CCU=y
CONFIG_AW_PINCTRL=y
CONFIG_AW_PINCTRL_SUN60IW2=y
CONFIG_AW_PINCTRL_SUN60IW2_R=y
CONFIG_AW_PCK600_DOMAINS=y
CONFIG_AW_SUN8I_NMI=y
CONFIG_AW_WAKEUPGEN=y
CONFIG_AW_SID=y
CONFIG_NVMEM_AW_SID=y
CONFIG_AW_SMC=y
CONFIG_AW_SYS_INFO=y
CONFIG_AW_DMA=y
CONFIG_AW_IOMMU=y
CONFIG_AW_IOMMU_V2=y
CONFIG_AW_RTC=y
CONFIG_AW_THERMAL=y
CONFIG_AW_TWI=y
CONFIG_AW_TIMER_SUN50I=y
CONFIG_AW_WATCHDOG=y
CONFIG_AW_NSI=y
CONFIG_AW_PWM=y
CONFIG_AW_RFKILL=y
CONFIG_AW_MACADDR_MGT=y
CONFIG_AW_CPUFREQ_DT=y
CONFIG_AW_CPUFREQ_DT_PLATDEV=y

# UART console & earlyprintk (Allwinner uart-ng + earlyprintk=sunxi-uart)
CONFIG_AW_UART_NG=y
# CONFIG_AW_UART is not set
# CONFIG_SERIAL_8250 is not set
CONFIG_AW_SERIAL_CONSOLE=y
CONFIG_AW_EARLY_PRINTK=y

# PMIC, Regulators & USB/Type-C Power Control (AXP515 / AXP8191 / AXP2101 / HUSB311)
CONFIG_AW_MFD_AXP2101=y
CONFIG_AW_MFD_AXP2101_I2C=y
CONFIG_AW_REGULATOR_AXP2101=y
CONFIG_AW_INPUT_AXP2101_PEK=y
CONFIG_AW_AXP515_POWER=y
CONFIG_AW_AXP8191_TEMP_CTRL=y
CONFIG_AW_POWER_SUPPLY_CTRL=y
CONFIG_AW_USB_POWER_CTRL=y
CONFIG_AW_TYPEC_HUSB311=y

# Storage (microSD, eMMC, UFS, NVMe/PCIe, USB SCSI disk)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_CQHCI=y
CONFIG_MMC_HSQ=y
CONFIG_AW_MMC=y
CONFIG_AW_MMC_V4P00X=y
CONFIG_AW_MMC_V4P1X=y
CONFIG_AW_MMC_V4P5X=y
CONFIG_AW_MMC_V5P3X=y
CONFIG_AW_UFS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_AW_PCIE_RC=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# USB 2.0 / USB 3.0 Host, PHY, DWC3, XHCI & USB Audio (ReSpeaker XVF3800)
CONFIG_USB_STORAGE=y
CONFIG_USB_SUNXI_USB=y
CONFIG_USB_SUNXI_HCD=y
CONFIG_USB_SUNXI_HCI=y
CONFIG_USB_EHCI_HCD_SUNXI=y
CONFIG_USB_OHCI_HCD_SUNXI=y
CONFIG_USB_SUNXI_EHCI0=y
CONFIG_USB_SUNXI_EHCI1=y
CONFIG_USB_SUNXI_OHCI0=y
CONFIG_USB_SUNXI_OHCI1=y
CONFIG_USB_SUNXI_DWC3=y
CONFIG_USB_SUNXI_USB_MANAGER=y
CONFIG_USB_SUNXI_TYPEC=y
CONFIG_DWC3_SUNXI_PLAT=y
CONFIG_PHY_SUNXI_PLAT=y
CONFIG_AW_CADENCE_COMBOPHY=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_SND_USB_AUDIO=y

# HDMI DRM Display & Framebuffer Console
CONFIG_AW_DRM=y
CONFIG_AW_DRM_DE=y
CONFIG_AW_DRM_TCON=y
CONFIG_AW_DRM_TCON_TOP=y
CONFIG_AW_DRM_TCON_TV=y
CONFIG_AW_DRM_HDMI_TX=y
CONFIG_AW_DRM_HDMI20=y
CONFIG_AW_DRM_PHY=y
CONFIG_AW_FB_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# CONFIG_AW_DISP2 is not set

# Ethernet (dwmac-sunxi + Motorcomm PHY)
CONFIG_PHYLIB=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_GENERIC=y
CONFIG_DWMAC_SUNXI=y
CONFIG_AW_STMMAC_ETH=m
CONFIG_AW_DWMAC_SUNXI=m
CONFIG_MOTORCOMM_PHY=m
# CONFIG_AW_GMAC is not set
# CONFIG_AW_GMAC_MDIO is not set
# CONFIG_JLSEMI_PHY is not set

# Wi-Fi & Bluetooth (AIC8800 SDIO + HCI_UART)
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_RFKILL_GPIO=y
CONFIG_AIC_WLAN_SUPPORT=y
CONFIG_AIC_INTF_SDIO=y
CONFIG_AIC_IRQ_ACTIVE_UNSET=y
CONFIG_AIC8800_WLAN_SUPPORT=m
CONFIG_AIC8800_BTLPM_SUPPORT=m
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCSP=y

# Audio (ES8389/ES8323 + AW87XXX + Sunxi I2S + HDMI)
CONFIG_SOUND=y
CONFIG_SND_SOC_SUNXI_COMMON=y
CONFIG_SND_SOC_SUNXI_MACH=y
CONFIG_SND_SOC_SUNXI_COMPONENTS=y
CONFIG_SND_SOC_SUNXI_I2S=y
CONFIG_SND_SOC_SUNXI_CODEC_HDMI=y
CONFIG_SND_SOC_ES8323=y
CONFIG_SND_SOC_AW87XXX=y

# RAUC Verity Bundle & SquashFS (loopback + dm-verity)
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y

# Disable conflicting mainline sunxi drivers and unused/broken vendor modules
# CONFIG_SUNXI_CCU is not set
# CONFIG_PINCTRL_SUN50I_A64 is not set
# CONFIG_PINCTRL_SUN50I_H5 is not set
# CONFIG_PINCTRL_SUN50I_H6 is not set
# CONFIG_PINCTRL_SUN50I_H616 is not set
# CONFIG_BCMDHD is not set
# CONFIG_AW_VIDEO_ENCODER_DECODER is not set
# CONFIG_AW_VIDEO_GOOGLE_DECODER is not set
