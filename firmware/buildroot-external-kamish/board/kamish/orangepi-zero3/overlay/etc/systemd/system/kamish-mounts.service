[Unit]
Description=KAMISH OS Persistent Data Mounts and Directories Initialization
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target kamish.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c '\
    mkdir -p /data/kamish /data/network /data/ssh /data/vpn /data/audio; \
    mkdir -p /var/lib/kamish; \
    mount --bind /data/kamish /var/lib/kamish 2>/dev/null || true'
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
