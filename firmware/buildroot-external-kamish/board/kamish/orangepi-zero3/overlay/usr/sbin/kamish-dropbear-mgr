#!/bin/sh
# KAMISH OS Dropbear SSH Manager
# Controls SSH access: disabled by default, temporary auto-generated password, root login disabled.

USER_NAME="kamish"
DATA_SSH_DIR="/data/ssh"
DROPBEAR_SERVICE="dropbear.service"

mkdir -p "${DATA_SSH_DIR}"
chmod 700 "${DATA_SSH_DIR}"

ensure_kamish_user() {
    if ! id "${USER_NAME}" >/dev/null 2>&1; then
        adduser -D -h "/home/${USER_NAME}" -s /bin/sh "${USER_NAME}" 2>/dev/null || \
        useradd -m -s /bin/sh "${USER_NAME}" 2>/dev/null
    fi
}

count_sessions() {
    # Count active sshd / dropbear sessions for kamish user
    who 2>/dev/null | grep -c "${USER_NAME}" || netstat -tn 2>/dev/null | grep -c ":22.*ESTABLISHED" || echo 0
}

case "$1" in
    status)
        IS_ACTIVE=false
        if systemctl is-active --quiet "${DROPBEAR_SERVICE}" 2>/dev/null; then
            IS_ACTIVE=true
        fi
        SESSIONS=$(count_sessions)
        echo "{\"enabled\": ${IS_ACTIVE}, \"active_sessions\": ${SESSIONS}, \"port\": 22, \"user\": \"${USER_NAME}\", \"root_login_allowed\": false}"
        ;;

    enable)
        ensure_kamish_user
        TEMP_PASS="$2"
        SSH_KEY="$3"

        if [ -n "${TEMP_PASS}" ]; then
            echo "${USER_NAME}:${TEMP_PASS}" | chpasswd 2>/dev/null
        fi

        if [ -n "${SSH_KEY}" ]; then
            mkdir -p "/home/${USER_NAME}/.ssh"
            echo "${SSH_KEY}" > "/home/${USER_NAME}/.ssh/authorized_keys"
            chmod 600 "/home/${USER_NAME}/.ssh/authorized_keys"
            chown -R "${USER_NAME}:${USER_NAME}" "/home/${USER_NAME}/.ssh"
        fi

        # Write dropbear defaults ensuring root login is forbidden (-w -g)
        mkdir -p /etc/default
        echo 'DROPBEAR_EXTRA_ARGS="-w -g -p 22"' > /etc/default/dropbear

        systemctl start "${DROPBEAR_SERVICE}" 2>/dev/null
        echo "{\"status\": \"ok\", \"enabled\": true, \"user\": \"${USER_NAME}\"}"
        ;;

    disable)
        systemctl stop "${DROPBEAR_SERVICE}" 2>/dev/null
        passwd -l "${USER_NAME}" >/dev/null 2>&1 || true
        echo "{\"status\": \"ok\", \"enabled\": false}"
        ;;

    *)
        echo "Usage: $0 {status|enable <temp_pass> [ssh_key]|disable}"
        exit 1
        ;;
esac
